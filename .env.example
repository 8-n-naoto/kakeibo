APP_NAME=家計簿アプリ
# 検証・本番のVMに置くときは production / false のまま使うこと
# （true だと例外画面にスタックトレースやDB接続情報が出て、LAN内の誰からでも見える）
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Tokyo
APP_URL=http://localhost:8000

APP_LOCALE=ja
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ja_JP

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kakeibo
# root で繋がない。漏れたときに他のDBまで巻き添えになる（README「セットアップ」の手順4参照）
DB_USERNAME=kakeibo
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# クロスサイトからのPOSTでセッションCookieを送らない。none にすると
# 一括編集・予算の上書き・除外ルールの削除がワンクリックで踏めるようになる。
SESSION_SAME_SITE=lax
# https で公開するときだけ true（http のままだとログインできなくなる）
# SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database

FILESYSTEM_DISK=local

# 1回のアップロードで受け付けるレシート画像の枚数（既定 20 / 有効範囲 1〜50）
# アップロードは保存するだけなので、増やすときは php.ini の post_max_size を確認する
RECEIPT_MAX_FILES_PER_UPLOAD=20

# レシート画像の解析に使うAI（gemini または claude）
RECEIPT_AI_DRIVER=gemini
# 1日にAIへ投げられるレシート枚数の上限（AI課金の歯止め）
# 有効範囲 1〜1000。0 を書いても 1 に切り上がるので、ほぼ止めたいときは 1 にする。
RECEIPT_AI_DAILY_LIMIT=200

# Gemini API（RECEIPT_AI_DRIVER=gemini のとき使用）
# キーの発行: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# 通常は変更不要。エンドポイント仕様が変わった場合のみ上書きする
# GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/interactions
# GEMINI_API_REVISION=2026-05-20

# Claude(Anthropic) API（RECEIPT_AI_DRIVER=claude のとき使用）
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# ---- セキュリティヘッダー ----
# CSP を強制するか。false の間は Report-Only（違反はコンソールに出るだけ）。
# 全画面を開いてコンソールに違反が出ないことを確かめてから true にする。
CSP_ENFORCE=false
# HSTS。https で公開してから有効にすること。
# 一度送ると、そのブラウザは HSTS_MAX_AGE 秒のあいだ http で開けなくなる。
# 有効にするなら SESSION_SECURE_COOKIE=true も一緒に入れること
# （HSTSだけだと、Cookie は http にも付いていく設定のまま残る）。
HSTS_ENABLED=false
HSTS_MAX_AGE=31536000
