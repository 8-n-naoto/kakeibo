{
  "name": "家計簿アプリ",
  "short_name": "家計簿",
  "description": "レシート画像をAIで読み取って家計簿につけ、月の収支・予算・資産を管理するアプリ",
  "lang": "ja",
  "dir": "ltr",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#f8fafc",
  "theme_color": "#059669",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "レシートを読み込む", "short_name": "レシート", "url": "/receipts/upload", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "未登録のレシート", "short_name": "未登録", "url": "/receipts/pending" },
    { "name": "手動で入力する", "short_name": "手動入力", "url": "/transactions/create" }
  ]
}
